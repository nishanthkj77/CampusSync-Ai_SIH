generator client {
  provider     = "prisma-client"
  output       = "../../apps/api/src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  HOD
  FACULTY
  STUDENT
}

enum ProgramLevel {
  UNDERGRADUATE
  POSTGRADUATE
  DIPLOMA
  DOCTORAL
}

enum AcademicTermType {
  ODD
  EVEN
  SUMMER
}

enum AcademicTermStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CourseType {
  CORE
  ELECTIVE
  LAB
  PROJECT
  SEMINAR
  SKILL
  VALUE_ADDED
}

enum EnrollmentStatus {
  ACTIVE
  DROPPED
  COMPLETED
}

enum RoomType {
  CLASSROOM
  LAB
  SEMINAR_HALL
  AUDITORIUM
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  PREFERRED
}

enum ScheduleRunStatus {
  DRAFT
  QUEUED
  RUNNING
  FEASIBLE
  OPTIMAL
  INFEASIBLE
  FAILED
  PUBLISHED
  ARCHIVED
}

enum ScheduleEntryStatus {
  GENERATED
  LOCKED
  MANUAL
}

enum IssueSeverity {
  INFO
  WARNING
  ERROR
}

enum IssueType {
  UNSCHEDULED_COURSE
  FACULTY_CONFLICT
  ROOM_CONFLICT
  SECTION_CONFLICT
  ROOM_CAPACITY
  ROOM_TYPE
  FACULTY_AVAILABILITY
  ROOM_AVAILABILITY
  WORKLOAD
  ELECTIVE_CONFLICT
  CONSTRAINT_VIOLATION
}

enum ConstraintScope {
  INSTITUTION
  DEPARTMENT
  PROGRAM
  SECTION
}

model User {
  id          String  @id @default(uuid()) @db.Uuid
  authSubject String  @unique
  email       String  @unique
  displayName String
  role        Role
  isActive    Boolean @default(true)

  facultyProfile FacultyProfile?
  studentProfile StudentProfile?

  createdScheduleRuns ScheduleRun[] @relation("ScheduleRunCreator")
  publishedScheduleRuns ScheduleRun[] @relation("ScheduleRunPublisher")
  auditLogs AuditLog[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([role, isActive])
}

model Department {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique
  name     String  @unique
  isActive Boolean @default(true)

  programs Program[]
  faculty FacultyProfile[]
  students StudentProfile[]
  courses Course[]
  scheduleRuns ScheduleRun[]
  constraintProfiles ConstraintProfile[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model Program {
  id                String       @id @default(uuid()) @db.Uuid
  code              String       @unique
  name              String
  level             ProgramLevel
  durationSemesters Int
  isActive          Boolean      @default(true)

  departmentId String     @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  sections Section[]
  students StudentProfile[]
  courseOfferings CourseOffering[]
  electiveBaskets ElectiveBasket[]
  scheduleRuns ScheduleRun[]
  constraintProfiles ConstraintProfile[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([departmentId, isActive])
}

model AcademicYear {
  id        String   @id @default(uuid()) @db.Uuid
  label     String   @unique
  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  terms AcademicTerm[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model AcademicTerm {
  id        String             @id @default(uuid()) @db.Uuid
  code      String
  name      String
  type      AcademicTermType
  status    AcademicTermStatus @default(DRAFT)
  startDate DateTime           @db.Date
  endDate   DateTime           @db.Date

  academicYearId String       @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  sections Section[]
  courseOfferings CourseOffering[]
  electiveBaskets ElectiveBasket[]
  enrollments StudentEnrollment[]
  timeSlots TimeSlot[]
  facultyAvailability FacultyAvailability[]
  roomAvailability RoomAvailability[]
  scheduleRuns ScheduleRun[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([academicYearId, code])
  @@index([status, startDate, endDate])
}

model Section {
  id        String  @id @default(uuid()) @db.Uuid
  name      String
  semester  Int
  batchYear Int
  capacity  Int?
  isActive  Boolean @default(true)

  programId String  @db.Uuid
  program   Program @relation(fields: [programId], references: [id], onDelete: Restrict)

  academicTermId String       @db.Uuid
  academicTerm   AcademicTerm @relation(fields: [academicTermId], references: [id], onDelete: Cascade)

  students StudentProfile[]
  courseOfferings CourseOffering[]
  scheduleEntries ScheduleEntry[]
  scheduleRuns ScheduleRun[]
  constraintProfiles ConstraintProfile[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([academicTermId, programId, semester, name])
  @@index([programId, semester, isActive])
}

model FacultyProfile {
  id               String  @id @default(uuid()) @db.Uuid
  employeeCode     String  @unique
  designation      String?
  maxWeeklyMinutes Int     @default(1080)
  isAvailable      Boolean @default(true)

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  departmentId String     @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  courseAssignments CourseOfferingFaculty[]
  availability FacultyAvailability[]
  scheduleEntries ScheduleEntry[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([departmentId, isAvailable])
}

model StudentProfile {
  id             String  @id @default(uuid()) @db.Uuid
  registerNumber String  @unique
  batchYear      Int
  isActive       Boolean @default(true)

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  departmentId String     @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  programId String  @db.Uuid
  program   Program @relation(fields: [programId], references: [id], onDelete: Restrict)

  sectionId String?  @db.Uuid
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  enrollments StudentEnrollment[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([departmentId, programId, batchYear, isActive])
  @@index([sectionId])
}

model Course {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique
  title       String
  courseType  CourseType
  credits     Decimal    @db.Decimal(4, 1)
  description String?
  isActive    Boolean    @default(true)

  departmentId String     @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  offerings CourseOffering[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([departmentId, courseType, isActive])
}

model CourseOffering {
  id                     String  @id @default(uuid()) @db.Uuid
  offeringCode           String
  semester               Int
  weeklySessions         Int
  sessionDurationMinutes Int
  requiresLab            Boolean @default(false)
  expectedEnrollment     Int?
  isActive               Boolean @default(true)

  courseId String @db.Uuid
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  academicTermId String       @db.Uuid
  academicTerm   AcademicTerm @relation(fields: [academicTermId], references: [id], onDelete: Cascade)

  programId String  @db.Uuid
  program   Program @relation(fields: [programId], references: [id], onDelete: Restrict)

  sectionId String?  @db.Uuid
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  facultyAssignments CourseOfferingFaculty[]
  enrollments StudentEnrollment[]
  electiveBasketLinks ElectiveBasketOffering[]
  scheduleEntries ScheduleEntry[]
  scheduleIssues ScheduleIssue[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([academicTermId, offeringCode])
  @@index([academicTermId, courseId, programId, semester, isActive])
  @@index([sectionId])
}

model CourseOfferingFaculty {
  courseOfferingId String         @db.Uuid
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)

  facultyId String         @db.Uuid
  faculty   FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  preferenceRank Int?
  isPrimary      Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@id([courseOfferingId, facultyId])
  @@index([facultyId])
}

model ElectiveBasket {
  id       String @id @default(uuid()) @db.Uuid
  code     String
  name     String
  semester Int

  academicTermId String       @db.Uuid
  academicTerm   AcademicTerm @relation(fields: [academicTermId], references: [id], onDelete: Cascade)

  programId String  @db.Uuid
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  offerings ElectiveBasketOffering[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([academicTermId, programId, semester, code])
}

model ElectiveBasketOffering {
  electiveBasketId String         @db.Uuid
  electiveBasket   ElectiveBasket @relation(fields: [electiveBasketId], references: [id], onDelete: Cascade)

  courseOfferingId String         @db.Uuid
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)

  @@id([electiveBasketId, courseOfferingId])
  @@index([courseOfferingId])
}

model StudentEnrollment {
  id     String           @id @default(uuid()) @db.Uuid
  status EnrollmentStatus @default(ACTIVE)

  studentId String         @db.Uuid
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  academicTermId String       @db.Uuid
  academicTerm   AcademicTerm @relation(fields: [academicTermId], references: [id], onDelete: Cascade)

  courseOfferingId String         @db.Uuid
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([studentId, courseOfferingId])
  @@index([academicTermId, status])
  @@index([courseOfferingId, status])
}

model Room {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  building    String?
  floor       String?
  roomType    RoomType
  capacity    Int
  isAvailable Boolean  @default(true)

  availability RoomAvailability[]
  scheduleEntries ScheduleEntry[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([roomType, capacity, isAvailable])
}

model TimeSlot {
  id          String    @id @default(uuid()) @db.Uuid
  day         DayOfWeek
  startMinute Int
  endMinute   Int
  label       String?
  isActive    Boolean   @default(true)

  academicTermId String       @db.Uuid
  academicTerm   AcademicTerm @relation(fields: [academicTermId], references: [id], onDelete: Cascade)

  facultyAvailability FacultyAvailability[]
  roomAvailability RoomAvailability[]
  scheduleEntries ScheduleEntry[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([academicTermId, day, startMinute, endMinute])
  @@index([academicTermId, day, startMinute, isActive])
}

model FacultyAvailability {
  id     String             @id @default(uuid()) @db.Uuid
  status AvailabilityStatus
  reason String?

  facultyId String         @db.Uuid
  faculty   FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  academicTermId String       @db.Uuid
  academicTerm   AcademicTerm @relation(fields: [academicTermId], references: [id], onDelete: Cascade)

  timeSlotId String   @db.Uuid
  timeSlot   TimeSlot @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)

  @@unique([facultyId, academicTermId, timeSlotId])
  @@index([academicTermId, status])
}

model RoomAvailability {
  id     String             @id @default(uuid()) @db.Uuid
  status AvailabilityStatus
  reason String?

  roomId String @db.Uuid
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  academicTermId String       @db.Uuid
  academicTerm   AcademicTerm @relation(fields: [academicTermId], references: [id], onDelete: Cascade)

  timeSlotId String   @db.Uuid
  timeSlot   TimeSlot @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)

  @@unique([roomId, academicTermId, timeSlotId])
  @@index([academicTermId, status])
}

model ScheduleRun {
  id            String            @id @default(uuid()) @db.Uuid
  name          String
  status        ScheduleRunStatus @default(DRAFT)
  solverVersion String?
  objectiveScore Decimal?         @db.Decimal(12, 4)
  metrics       Json?
  inputSnapshot Json?
  startedAt     DateTime?         @db.Timestamptz(6)
  completedAt   DateTime?         @db.Timestamptz(6)
  publishedAt   DateTime?         @db.Timestamptz(6)

  academicTermId String       @db.Uuid
  academicTerm   AcademicTerm @relation(fields: [academicTermId], references: [id], onDelete: Restrict)

  departmentId String     @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  programId String?  @db.Uuid
  program   Program? @relation(fields: [programId], references: [id], onDelete: SetNull)

  sectionId String?  @db.Uuid
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  createdById String @db.Uuid
  createdBy   User   @relation("ScheduleRunCreator", fields: [createdById], references: [id], onDelete: Restrict)

  publishedById String? @db.Uuid
  publishedBy   User?   @relation("ScheduleRunPublisher", fields: [publishedById], references: [id], onDelete: SetNull)

  entries ScheduleEntry[]
  issues ScheduleIssue[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([academicTermId, departmentId, status])
  @@index([programId, sectionId])
}

model ScheduleEntry {
  id           String              @id @default(uuid()) @db.Uuid
  sessionIndex Int
  status       ScheduleEntryStatus @default(GENERATED)

  scheduleRunId String      @db.Uuid
  scheduleRun   ScheduleRun @relation(fields: [scheduleRunId], references: [id], onDelete: Cascade)

  courseOfferingId String         @db.Uuid
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Restrict)

  facultyId String         @db.Uuid
  faculty   FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Restrict)

  roomId String @db.Uuid
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Restrict)

  timeSlotId String   @db.Uuid
  timeSlot   TimeSlot @relation(fields: [timeSlotId], references: [id], onDelete: Restrict)

  sectionId String?  @db.Uuid
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([scheduleRunId, courseOfferingId, sessionIndex])
  @@unique([scheduleRunId, facultyId, timeSlotId])
  @@unique([scheduleRunId, roomId, timeSlotId])
  @@index([scheduleRunId, sectionId, timeSlotId])
  @@index([scheduleRunId, timeSlotId])
}

model ScheduleIssue {
  id       String        @id @default(uuid()) @db.Uuid
  type     IssueType
  severity IssueSeverity
  code     String
  message  String
  details  Json?
  resolved Boolean       @default(false)

  scheduleRunId String      @db.Uuid
  scheduleRun   ScheduleRun @relation(fields: [scheduleRunId], references: [id], onDelete: Cascade)

  courseOfferingId String?         @db.Uuid
  courseOffering   CourseOffering? @relation(fields: [courseOfferingId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([scheduleRunId, severity, resolved])
  @@index([type])
}

model ConstraintProfile {
  id       String          @id @default(uuid()) @db.Uuid
  name     String
  scope    ConstraintScope
  config   Json
  isActive Boolean         @default(true)

  departmentId String?     @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  programId String?  @db.Uuid
  program   Program? @relation(fields: [programId], references: [id], onDelete: Cascade)

  sectionId String?  @db.Uuid
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([scope, isActive])
}

model AuditLog {
  id         String @id @default(uuid()) @db.Uuid
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?

  actorId String? @db.Uuid
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}
